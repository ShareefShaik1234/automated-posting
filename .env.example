# GitHub Personal Access Token (scope: gist)
GITHUB_TOKEN=ghp_your_token_here

# Telegraph Access Token (generate via https://api.telegra.ph/createAccount?short_name=Bot)
TELEGRAPH_ACCESS_TOKEN=your_telegraph_token_here

# Pastebin API Dev Key (https://pastebin.com/doc_api)
PASTEBIN_API_KEY=your_pastebin_dev_key_here

# Dev.to API Key (Settings -> Extensions -> DEV Community API Keys)
DEVTO_API_KEY=your_devto_api_key_here

# Mastodon Instance & Access Token (Preferences -> Development -> New Application)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_token_here
